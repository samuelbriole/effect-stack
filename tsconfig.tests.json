{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "include": [
    "vitest.config.ts",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "packages/*/typetest/**/*.ts",
    "packages/*/typetest/**/*.tsx"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "packages/query-solid/**",
    "packages/query-vue/**",
    "packages/router-solid/**",
    "packages/router-vue/**"
  ],
  "references": [
    { "path": "packages/query" },
    { "path": "packages/query-react" },
    { "path": "packages/router" },
    { "path": "packages/router-react" }
  ],
  "compilerOptions": {
    "rootDir": ".",
    "jsx": "react-jsx",
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "types": ["node", "vitest/globals"]
  }
}
