{
  "name": "effect-stack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "tsc -b tsconfig.packages.json",
    "build:examples": "pnpm --filter @effect-stack-example/router-react build && pnpm --filter @effect-stack-example/router-solid build && pnpm --filter @effect-stack-example/router-vue build",
    "check": "tsc -b tsconfig.json",
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "lint": "pnpm prepare && oxlint --deny-warnings --report-unused-disable-directives -f unix && oxfmt --check .",
    "lint-fix": "pnpm prepare && oxlint --deny-warnings --report-unused-disable-directives --fix && oxfmt --write .",
    "format": "oxfmt --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test-types": "tstyche --target '>=5.9'",
    "pack:check": "pnpm build && node scripts/check-package.mjs",
    "changeset": "changeset",
    "changeset-version": "changeset version",
    "changeset-publish": "pnpm build && changeset publish",
    "ci": "pnpm lint && pnpm check && pnpm test:run && pnpm test-types && pnpm build && pnpm build:examples && pnpm pack:check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/atom-react": "4.0.5",
    "@effect/atom-solid": "4.0.5",
    "@effect/atom-vue": "4.0.5",
    "@effect/tsgo": "0.54.0",
    "@effect/vitest": "4.0.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/scheduler": "0.28.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "6.0.10",
    "effect": "4.0.5",
    "happy-dom": "21.0.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "scheduler": "0.28.0",
    "solid-js": "1.9.17",
    "tstyche": "7.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
