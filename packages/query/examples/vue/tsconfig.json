{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../../../tsconfig.base.json",
  "include": ["src"],
  "references": [
    { "path": "../shared" },
    { "path": "../../../query" },
    { "path": "../../../query-vue" },
    { "path": "../../../router" }
  ],
  "compilerOptions": {
