{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": ["typescript", "import", "oxc", "eslint", "unicorn", "node", "effecttsgo"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-types/**",
    "**/coverage/**",
    "**/*.tsbuildinfo",
    "**/CHANGELOG.md"
  ],
  "rules": {
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "eslint/no-console": "error",
    "eslint/no-var": "error",
    "eslint/require-yield": "off",
    "eslint/no-underscore-dangle": ["error", { "allow": ["_tag"] }],
    "typescript/no-explicit-any": "off",
    "typescript/no-empty-interface": "off",
    "typescript/no-namespace": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "effecttsgo/any-unknown-in-error-context": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off"
  },
  "overrides": [
    {
      "files": ["packages/*/test/**/*", "packages/*/typetest/**/*"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/new-promise": "off",
        "effecttsgo/global-timers": "off"
      }
    },
    {
      "files": ["packages/*/examples/**/*", "packages/*/test/**/*", "packages/*/typetest/**/*"],
      "rules": {
        "eslint/no-console": "off",
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["packages/router/src/**/*", "packages/router/test/**/*", "packages/router/typetest/**/*"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              "react",
              "react/*",
              "solid-js",
              "solid-js/*",
              "vue",
              "vue/*",
              "@effect/atom-react",
              "@effect/atom-solid",
              "@effect/atom-vue"
            ]
          }
        ]
      }
    }
  ]
}
